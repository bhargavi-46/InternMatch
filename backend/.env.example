# "local" runs an embedded Postgres + pgvector in backend/.pgdata (no account needed).
# To deploy, replace it with your Neon connection string (Neon dashboard -> Connect).
DATABASE_URL=local

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: openai/gpt-oss-20b is faster; openai/gpt-oss-120b (default) gives better answers.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional free keys: https://developer.adzuna.com (adds internship and fresher listings across India)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Comma-separated frontend URLs allowed to call the API.
# CORS_ORIGINS=http://localhost:3000
