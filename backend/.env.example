# "local" runs an embedded Postgres + pgvector (no account needed). Its data lives outside the project:
# %LOCALAPPDATA%\InternMatch on Windows, ~/.local/share/InternMatch elsewhere.
# To deploy, replace it with your Neon connection string (Neon dashboard -> Connect).
DATABASE_URL=local

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: openai/gpt-oss-20b is faster; openai/gpt-oss-120b (default) gives better answers.
# GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated frontend URLs allowed to call the API.
# CORS_ORIGINS=http://localhost:3000
